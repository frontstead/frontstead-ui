{
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "noEmit": true,
    "incremental": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["react", "react-dom", "node"],
    "target": "es2022",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
