  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontstead/frontstead-ui.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "npm run palette:check && tsup",
    "consumer:test": "node --import tsx scripts/test-consumer.ts",
    "palette:check": "node --import tsx scripts/generate-palette.ts --check",
    "palette:generate": "node --import tsx scripts/generate-palette.ts",
    "prepack": "npm run test && npm run typecheck && npm run build && npm run tarball:verify",
    "tarball:verify": "node scripts/verify-tarball.mjs",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --project tsconfig.json --pretty false"
  }
}
